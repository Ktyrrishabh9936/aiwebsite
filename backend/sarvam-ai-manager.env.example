# Append these settings to backend/.env. Leave disabled until configured.
# This is the AREVEI tool bearer secret, NOT your Sarvam platform API key.
# Generate a random secret locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
SARVAM_AI_MANAGER_ENABLED=false
SARVAM_AI_MANAGER_API_KEY=
# User and workspace routing is dynamic. Each signed-in user connects their
# calling phone number to a workspace from that workspace's Settings page.
